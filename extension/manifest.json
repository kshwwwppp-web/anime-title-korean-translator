{
  "manifest_version": 3,
  "name": "Anime Title Korean Translator",
  "version": "6.0.0",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://inputtools.google.com/*",
    "https://translate.googleapis.com/*",
    "https://ko.wikipedia.org/*",
    "https://en.wikipedia.org/*",
    "https://ja.wikipedia.org/*",
    "https://graphql.anilist.co/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_popup": "options.html",
    "default_title": "애니 제목 번역 설정",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "Anime Translator",
  "description": "사용자가 허용한 웹사이트의 애니메이션 제목을 한국어로 표시하고 수동 치환 규칙을 지원합니다."
}